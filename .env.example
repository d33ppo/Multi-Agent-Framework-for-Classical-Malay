# Copy this file to .env and fill in the values. Never commit .env.
# These are the variables the code reads today.
# The three model lines are commented out on purpose: a variable that is set but
# empty is used as an empty model name. Uncomment a line only when you give it a value.

# OpenRouter API key. Leave empty to run the agents in offline mock mode.
OPENROUTER_API_KEY=

# Positive integer that overrides the per-agent max_tokens limit on every OpenRouter text call. Empty means no override.
OPENROUTER_MAX_TOKENS=

# OpenRouter model ID for the translation, summary and knowledge agents. When unset: google/gemini-2.5-flash
# OPENROUTER_MODEL=

# OpenRouter vision model used only by the ocr_llm.py OCR baseline, which sends the page image to OpenRouter. When unset: google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL=

# HuggingFace model ID for romanisation Method A, run locally. When unset: mesolitica/jawi-nanot5-small-malaysian-cased
# JAWI_NEURAL_MODEL=
