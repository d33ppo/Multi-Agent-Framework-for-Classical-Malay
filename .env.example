# Copy this file to .env and fill in the values. Never commit .env.
# These are the variables the code reads today.
# A variable that is set but empty is treated as unset. The one exception is
# JAWI_NEURAL_MODEL, which stays commented out until you give it a value.

# OpenRouter API key. Required for live runs.
# Without it the API returns 503 (unless APP_MODE=demo_mock) and the CLI runs in mock mode.
OPENROUTER_API_KEY=

# Must be true before any manuscript data leaves this machine. It covers the translation,
# summary and knowledge agents (manuscript text) and ocr_llm.py (page images), all sent to OpenRouter.
# With false, live runs are refused even when the key is set.
ALLOW_EXTERNAL_MANUSCRIPT_API=false

# Set to demo_mock to let the API serve mock output when live runs are not available,
# and to accept "model": "mock". Mock runs are labelled mode=mock. Leave empty for normal use.
APP_MODE=

# Comma-separated OpenRouter model IDs an API client may request. Any other model gets 400.
# When unset: google/gemini-2.5-flash
OPENROUTER_ALLOWED_MODELS=

# OpenRouter model ID used by the CLI, and by the API when a request names no model.
# For the API it must also be in OPENROUTER_ALLOWED_MODELS. When unset: google/gemini-2.5-flash
OPENROUTER_MODEL=

# Positive integer that overrides the per-agent max_tokens limit on every OpenRouter text call. Empty means no override.
OPENROUTER_MAX_TOKENS=

# OpenRouter vision model used only by the ocr_llm.py OCR baseline. When unset: google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=

# Comma-separated browser origins allowed to call the API (CORS).
# When unset: http://localhost:5173,http://localhost:8000
CORS_ALLOWED_ORIGINS=

# Maximum number of characters accepted in jawi_text by POST /api/pipeline/run. When unset: 50000
MAX_TEXT_CHARS=

# Full path to the Tesseract executable. When unset, tesseract is looked up on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Largest upload accepted by POST /api/documents, in megabytes. When unset: 25
MAX_UPLOAD_MB=

# Most pages one uploaded document may have. When unset: 30
MAX_UPLOAD_PAGES=

# Resolution used to render PDF pages to images for OCR. When unset: 300
PDF_RENDER_DPI=

# OCR provider for uploaded documents: trocr (fine-tuned model), tesseract (local baseline)
# or fixture (saved text, for tests and demos).
# When unset: trocr if OCR_MODEL_PATH is set, otherwise tesseract.
OCR_PROVIDER=

# Folder with the fine-tuned TrOCR model and processor (not committed), e.g. models/trocr_v1.
# Setting it makes trocr the default provider. Uploads return 503 if the folder is missing.
OCR_MODEL_PATH=

# YOLO line detector weights used by the trocr provider. When unset: models/yolo/qalam_lines_cpu25.pt
LINE_DETECTOR_PATH=

# Image size passed to the line detector; keep the size it was trained at. When unset: 960
LINE_DETECTOR_IMGSZ=

# TrOCR decoding: 1 = greedy (the decoding behind the reported test CER), more = beam search. When unset: 1
OCR_NUM_BEAMS=

# Line crops decoded together by TrOCR. Lower it if the machine runs out of memory. When unset: 4
OCR_BATCH_SIZE=

# CPU threads used by torch for TrOCR. When unset: torch default
OCR_TORCH_THREADS=

# auto (CUDA when available, otherwise CPU), cpu or cuda. When unset: auto
OCR_DEVICE=

# Lines with a TrOCR confidence below this are flagged low_confidence. UNCALIBRATED until task 3.6:
# the flag is a hint for the reviewer and does not change the run status. When unset: 0.60
OCR_CONFIDENCE_THRESHOLD=

# Folder the fixture provider reads. Page N of article.pdf is article_N.txt or article_pN.txt;
# a one-page upload may also use article.txt. When unset: data/ocr_fixtures
OCR_FIXTURE_DIR=

# Folder for uploaded documents, rendered pages, OCR output and run records. Not committed. When unset: storage
STORAGE_DIR=

# Number of uploaded documents processed at the same time. When unset: 1
JOB_WORKERS=

# HuggingFace model ID for romanisation Method A, run locally. When unset: mesolitica/jawi-nanot5-small-malaysian-cased
# JAWI_NEURAL_MODEL=
